# Multimodal Studio — Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env or share sensitive API keys / credentials with the public.
# On Google Cloud Run, configure these as service environment variables or Secret Manager secrets.

# ----------------------------------------------------------------------------
# 1. Google Gemini API (Required)
# ----------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary text & slide generation model: gemini-3.8-flash (fast, economical) or gemini-4-argon (high reasoning)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.8-flash

# Expressive Voice Narration (Gemini 3.8 Live with human-like expressions):
# https://ai.google.dev/gemini-api/docs/models/gemini-3.8-live
# Models: gemini-3.8-live (primary expressive voice), with gemini-3.8-flash-tts as fallback
GEMINI_TTS_MODEL=gemini-3.8-live
# Prebuilt Gemini Live voice: Kore (Female, Firm/Engaging), Aoede (Female, Breezy/Warm),
# Charon (Male, Informative/Deep), Puck (Male, Upbeat), Fenrir, Leda, Orus, Zephyr
GEMINI_TTS_VOICE=Kore

# In-app Assistant voice (Gemini 3.8 Live full-duplex WebSocket):
INTERVIEW_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Thumbnails: Gemini Nano Banana Pro (Cloud image generation)
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# ----------------------------------------------------------------------------
# 2. Firebase & Google Cloud Firestore (Job Snapshot Mirror)
# ----------------------------------------------------------------------------
# Set to true to mirror studio job snapshots to Firestore collection 'studio_jobs'
FIRESTORE_ENABLED=true
FIRESTORE_COLLECTION=studio_jobs

# ----------------------------------------------------------------------------
# 3. Authentication & Access Control
# ----------------------------------------------------------------------------
# Bootstrap admin account (synced to SQLite on server start):
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=your_secure_admin_password_here
AUTH_SECRET_KEY=generate_a_random_secret_key_for_cookie_sessions_here
AUTH_SESSION_PERSISTENT=false
AUTH_SESSION_HOURS=720

# ----------------------------------------------------------------------------
# 4. Public Demo Mode (For Hosted Review / Judging Link)
# ----------------------------------------------------------------------------
# When true, the auth gate is bypassed: visitors land directly in Studio
# without needing to sign in. Recommended on Cloud Run demo services.
DEMO_PUBLIC=false

# ----------------------------------------------------------------------------
# 5. Topic Web Research & Content Grounding (Free DuckDuckGo by default)
# ----------------------------------------------------------------------------
TOPIC_RESEARCH_ENABLED=true
TOPIC_RESEARCH_MAX_RESULTS=4
TOPIC_RESEARCH_FETCH_PAGES=2
TOPIC_RESEARCH_TIMEOUT=8.0
# Optional paid search APIs (free DuckDuckGo + Wikipedia run if empty):
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# ----------------------------------------------------------------------------
# 6. Admin Automation & Cron (Trending Papers -> Overnight Video Pipeline)
# ----------------------------------------------------------------------------
AUTO_ENABLED=false
AUTO_SOURCE=trending
AUTO_SS_QUERY=large language model OR multimodal OR diffusion OR generative AI
